{
  // PostalCR API: archivos estáticos servidos por Cloudflare, sin código propio.
  "name": "postalcr-api",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Rutas inexistentes responden 404 sin cuerpo.
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "api.postalcr.dev", "custom_domain": true }],
  "workers_dev": false,
  // Registros y trazas en el panel de Cloudflare (Workers → postalcr-api → Observability).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // URL de prueba en cada PR (Workers Builds).
  "previews": {}
}
